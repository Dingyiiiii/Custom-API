<domain type='kvm'>
  <name>customapi-freebsd</name>
  <title>Custom-API FreeBSD test guest (headless, serial console only)</title>
  <description>FreeBSD 15.1-RELEASE guest bridged onto the LAN. No graphics device and sshd disabled: the libvirt serial console is the only way in. Console: virsh -c qemu:///system console customapi-freebsd</description>
  <memory unit='MiB'>4096</memory>
  <currentMemory unit='MiB'>4096</currentMemory>
  <vcpu placement='static'>4</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
    <boot dev='cdrom'/>
    <bootmenu enable='no'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='4' threads='1'/>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <!-- The emulator path is deliberately omitted so libvirt uses its own
         configured default. It differs by distribution
         (/usr/bin/qemu-system-x86_64 on Fedora, /usr/libexec/qemu-kvm on
         RHEL-derived hosts), and a wrong path makes the domain fail to define
         with "cannot check QEMU binary". -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='writeback' discard='unmap'/>
      <source file='/var/lib/libvirt/images/customapi/customapi-freebsd.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/customapi/customapi-freebsd-seed.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <controller type='virtio-serial' index='0'/>
    <!-- The MAC is pinned rather than generated.
         The LAN's DHCP/DNS server holds a static reservation binding this
         address to the name the guest uses, so a random address would leave the
         guest reachable only at an unpredictable address and break name
         resolution for it. -->
    <interface type='network'>
      <mac address='52:54:00:19:44:f8'/>
      <source network='external-macvtap'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <!-- A second serial port, purely as a diagnostic: if ttyu0 is silent but
         ttyu1 answers, the guest is alive and the problem is which port its
         console is attached to, not the guest itself. -->
    <serial type='pty'>
      <target type='isa-serial' port='1'/>
    </serial>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <memballoon model='none'/>
  </devices>
</domain>
