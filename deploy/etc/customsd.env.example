# Custom-API customs gateway secrets.
#
# Install as /usr/local/etc/customapi/customsd.env with mode 0640 and group
# ownership by the service user, so the daemon can read it after dropping
# privileges:
#
#   chown root:customapi /usr/local/etc/customapi/customsd.env
#   chmod 640 /usr/local/etc/customapi/customsd.env
#
# The rc.d script refuses to start the service if either is wrong, because a
# service that cannot read its own credentials starts successfully and then
# fails every request - which is much harder to diagnose than a refusal.
#
# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
#
# A provider is one vendor plus its API keys. Every enabled key becomes its own
# routable channel: "<provider>" when the provider has one key, or
# "<provider>/<key>" when it has several. Several keys therefore give you
# per-key failover for free: a key that rate-limits or errors is one unhealthy
# channel and the router moves to the next.
#
# Single-key provider:
#   CUSTOMS_PROVIDER_<PROVIDER>_APIKEY=sk-...
#
# One key of a multi-key provider (the name must match the key's "name" in
# customs.json):
#   CUSTOMS_PROVIDER_<PROVIDER>_KEY_<KEYNAME>_APIKEY=sk-...
#
# Override the endpoint (rarely needed):
#   CUSTOMS_PROVIDER_<PROVIDER>_BASEURL=https://api.example.com
#
# The name is upper-cased for the environment, so provider "newapi" with key
# "main" becomes CUSTOMS_PROVIDER_NEWAPI_KEY_MAIN_APIKEY.
#
# Every character an environment variable cannot carry becomes an underscore, so
# a provider named after its host works without renaming it: "naapi.cc" with key
# "main" is CUSTOMS_PROVIDER_NAAPI_CC_KEY_MAIN_APIKEY.
#
# A provider whose key is missing from this file is still routable but sends no
# credential, so the upstream answers 401. That failure is visible in the audit
# ledger as an upstream_error against the channel.

CUSTOMS_PROVIDER_NAAPI_CC_KEY_MAIN_APIKEY=replace-me-with-the-naapi.cc-key
CUSTOMS_PROVIDER_0EGAESHOP_XYZ_KEY_MAIN_APIKEY=replace-me-with-the-0egaeshop.xyz-key
CUSTOMS_PROVIDER_VSLLM_COM_KEY_MAIN_APIKEY=replace-me-with-the-vsllm.com-key

# ---------------------------------------------------------------------------
# Gateway client tokens
# ---------------------------------------------------------------------------
#
# Each client presents one of these instead of an upstream key. The gateway
# substitutes the provider credential, so client keys are never forwarded
# upstream. Generate with: openssl rand -hex 32
#
# The name must match a user's "name" in customs.json, upper-cased.
# The user "probe" is reserved: the intelligence daemon (benchd) uses it for
# synthetic traffic, which keeps probe spend separable from user spend in the
# audit ledger.

CUSTOMS_USER_ADMIN_TOKEN=replace-me-admin-token
CUSTOMS_USER_PROBE_TOKEN=replace-me-probe-token
CUSTOMS_USER_ALICE_TOKEN=replace-me-alice-token

# ---------------------------------------------------------------------------
# Optional server overrides
# ---------------------------------------------------------------------------
#
# CUSTOMS_SERVER_LISTEN=0.0.0.0:8080
# CUSTOMS_SERVER_ADMIN_LISTEN=127.0.0.1:8081
# CUSTOMS_SERVER_LOG_LEVEL=debug
# CUSTOMS_SERVER_FAIL_MODE=closed
# CUSTOMS_SERVER_ROUTE_STRATEGY=value
#
# ---------------------------------------------------------------------------
# Remote management access (off by default)
# ---------------------------------------------------------------------------
#
# The management API and the console listen on 127.0.0.1 by default, and the
# handler refuses callers that are not on the loopback interface even if the
# listener is moved. That is deliberate: /admin/* can suspend users, rewrite
# quotas and read the whole audit ledger.
#
# To reach the console from another machine, do both of these:
#
#   1. point the listener at a routable address
#        CUSTOMS_SERVER_ADMIN_LISTEN=0.0.0.0:8081
#   2. turn on remote access and set a credential
#        CUSTOMS_SERVER_ADMIN_REMOTE=yes
#        CUSTOMS_SERVER_ADMIN_TOKEN=<openssl rand -hex 32>
#
# Step 2 is not optional: without it the listener answers 403 to every remote
# caller, and with it every remote caller must present the token as a bearer
# credential. The console prompts for it and keeps it in sessionStorage only.
# Prefer an SSH tunnel over this:
#
#   ssh -N -L 8081:127.0.0.1:8081 root@gateway
#
# CUSTOMS_SERVER_ADMIN_REMOTE=no
# CUSTOMS_SERVER_ADMIN_TOKEN=
